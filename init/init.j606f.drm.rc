# Widevine en la J606F: forzar L3.
#
# L1 funciona con patches/frameworks/av (SecureBuffer conserva el rango). Sin ese
# parche, Android 16 pasa al descodificador seguro el bufer entero y la imagen sale
# verde, con artefactos, o Venus se cae. Para esos casos, con J606F_WIDEVINE_L3=true
# device.mk fija la propiedad y aqui se tapa liboemcrypto: el CDM pasa a L3 y usa el
# descodificador normal.
on post-fs && property:ro.vendor.j606f.widevine_l3=true
    mount none /vendor/etc/drm/liboemcrypto-vacio.so /vendor/lib64/liboemcrypto.so bind
