     SPDX-License-Identifier: Apache-2.0

     Lenovo Tab P11 (TB-J606F): tablet solo Wi-Fi, LCD 1200x2000.
     Fuentes: overlay del Pro1-X (LineageOS), arbol AOSPA de StyloGey y
     valores del stock S320383 (hilo 4PDA #2250 para la curva de autobrillo).
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Autobrillo: curva del firmware stock S320383 (240603) -->
    <bool name="config_automatic_brightness_available">true</bool>
    <integer-array name="config_autoBrightnessLevels">
        <item>10</item>
        <item>60</item>
        <item>210</item>
        <item>350</item>
        <item>420</item>
        <item>1000</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>26</item>
        <item>26</item>
        <item>64</item>
        <item>96</item>
        <item>191</item>
        <item>255</item>
        <item>255</item>
    </integer-array>

    <!-- Tapa magnetica: el driver hall de Lenovo envia SW_LID (drivers/lenovo/input/hall.c) -->
    <bool name="config_lidControlsSleep">true</bool>
    <integer name="config_lidOpenRotation">-1</integer>
    <integer name="config_lidKeyboardAccessibility">0</integer>
    <integer name="config_lidNavigationAccessibility">0</integer>

    <!-- Solo Wi-Fi: sin voz, SMS ni datos moviles -->
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>
    <bool name="config_mobile_data_capable">false</bool>
    <integer name="config_num_physical_slots">0</integer>
    <bool name="config_eap_sim_based_auth_supported">false</bool>

    <!-- Rotacion libre en las cuatro orientaciones -->
    <bool name="config_allowAllRotations">true</bool>

    <!-- LCD a 60 Hz; sin pantalla siempre activa (coste de bateria en LCD) -->
    <integer name="config_defaultPeakRefreshRate">60</integer>
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.06667</item>

    <integer-array name="config_availableColorModes">
        <item>0</item> <!-- COLOR_MODE_NATURAL -->
        <item>1</item> <!-- COLOR_MODE_BOOSTED -->
    </integer-array>

    <!-- Sin LED de notificacion ni motor de vibracion -->
    <bool name="config_intrusiveNotificationLed">false</bool>
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- Bluetooth (valores de StyloGey/AOSPA) -->
    <integer name="config_bluetooth_idle_cur_ma">7</integer>
    <integer name="config_bluetooth_rx_cur_ma">75</integer>
    <integer name="config_bluetooth_tx_cur_ma">93</integer>
    <integer name="config_bluetooth_operating_voltage_mv">3700</integer>

    <bool name="config_showNavigationBar">true</bool>
    <bool name="config_enableWifiDisplay">true</bool>
    <bool name="config_useDevInputEventForAudioJack">true</bool>
    <bool name="config_supportAudioSourceUnprocessed">true</bool>
    <bool name="config_sustainedPerformanceModeSupported">true</bool>
    <bool name="config_supportsRoundedCornersOnWindows">false</bool>

    <!-- Fijar en RAM lo que mas se usa al cambiar de app (4 GB) -->
    <string-array name="config_defaultPinnerServiceFiles" translatable="false">
        <item>"/system/framework/framework.jar"</item>
        <item>"/system/framework/services.jar"</item>
        <item>"/apex/com.android.art/javalib/core-oj.jar"</item>
        <item>"/apex/com.android.art/javalib/core-libart.jar"</item>
        <item>"/system_ext/priv-app/SystemUI/SystemUI.apk"</item>
        <item>"/system/bin/surfaceflinger"</item>
    </string-array>
    <integer name="config_pinnerHomePinBytes">6291456</integer>
</resources>
