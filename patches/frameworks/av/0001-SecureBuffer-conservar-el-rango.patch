+SecureBuffer::SecureBuffer(const sp<AMessage> &format, const void *ptr,
+        const sp<NativeHandle> &handle, const sp<ABuffer> &range)
+    : MediaCodecBuffer(format, range),
+      mPointer(ptr),
+      mHandle(handle),
+      mRange(range) {
+}
+
+status_t SecureBuffer::setRange(size_t offset, size_t size) {
+    if (offset > capacity() || size > capacity() - offset) {
+        return BAD_VALUE;
+    }
+    mRange->setRange(offset, size);
+    return OK;
