   if (error != kErrorNone) {
-    DLOGE("Failed to setup panel feature factory, error: %d", error);
+    // J606F: son opcionales, no deben impedir que se cree la pantalla.
+    DLOGW("Failed to setup panel feature factory, error: %d", error);
+    error = kErrorNone;
   } else {
     // Get status of RC enablement property. Default RC is disabled.
     int rc_prop_value = 0;
@@ -207,8 +209,8 @@
