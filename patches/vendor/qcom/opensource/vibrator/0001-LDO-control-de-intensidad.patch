     snprintf(devicename, sizeof(devicename), "%s/%s", LED_DEVICE, "device/driver");
     mIsLdo = realpath(devicename, devicename) && strstr(devicename, "/qcom,qpnp-vibrator-ldo");
+
+    if (mIsLdo) {
+        /*
+         * El voltaje del DT es el de amplitud 1.0. Se lee del DT y no de vmax_mv,
+         * que es lo que escribe setAmplitude(): tras reiniciar el HAL valdria menos.
+         */
+        uint8_t be[4];
+        snprintf(devicename, sizeof(devicename), "%s/%s", LED_DEVICE,
+                 "device/of_node/qcom,vib-ldo-volt-uv");
+        fd = TEMP_FAILURE_RETRY(open(devicename, O_RDONLY));
+        if (fd >= 0) {
+            if (read(fd, be, sizeof(be)) == sizeof(be))
+                mVmaxMv = ((be[0] << 24) | (be[1] << 16) | (be[2] << 8) | be[3]) / 1000;
+            close(fd);
+        }
+        if (mVmaxMv <= 0) {
+            char value[16] = {};
+            snprintf(devicename, sizeof(devicename), "%s/%s", LED_DEVICE, "vmax_mv");
+            fd = TEMP_FAILURE_RETRY(open(devicename, O_RDONLY));
+            if (fd >= 0) {
+                if (read(fd, value, sizeof(value) - 1) > 0)
+                    mVmaxMv = atoi(value);
+                close(fd);
+            }
+        }
+        ALOGI("LDO vibrator, vmax %d mV", mVmaxMv);
+    }
+}
+
+/*
+ * Amplitud en el vibrador LDO (motor ERM): se escala el voltaje entre el minimo del
+ * LDO y el del DT. Por debajo de kMinAmplitude un ERM apenas arranca y solo zumba
+ * (los "ticks" del control de volumen de SystemUI van al 4-20 %): no se vibra.
+ */
+int LedVibratorDevice::setAmplitude(float amplitude) {
+    static constexpr int kLdoMinMv = 1504;
+    static constexpr int kLdoStepMv = 8;
+    static constexpr float kMinAmplitude = 0.3f;
+    char file[PATH_MAX];
+    char value[16];
+
+    if (!mIsLdo || mVmaxMv <= kLdoMinMv)
+        return -EINVAL;
+
+    if (amplitude < kMinAmplitude)
+        return off();
+
+    int mv = kLdoMinMv + (int)(amplitude * (mVmaxMv - kLdoMinMv));
+    mv = std::min(mVmaxMv, mv - (mv - kLdoMinMv) % kLdoStepMv);
+    snprintf(file, sizeof(file), "%s/%s", LED_DEVICE, "vmax_mv");
+    snprintf(value, sizeof(value), "%d", mv);
+    return write_value(file, value);
 }
 
